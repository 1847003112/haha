# ===== DashScope API（必填：把下面的 key 换成你自己的）=====
QWEN_API_KEY=sk-你的APIKey
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max-2026-05-17

# 嵌入模型（稠密向量）
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# 视觉/OCR 模型（扫描件、图片识别）
QWEN_VL_OCR_MODEL=qwen-vl-max

# ===== 认证（JWT）=====
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_DEPARTMENT=公共
ALLOW_REGISTRATION=true

# ===== MySQL（与 docker-compose.yml 对齐：库名 smart_query、密码 123456）=====
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=smart_query

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== HuggingFace（下载 bge-m3 / bge-reranker 模型用）=====
HF_HOME=./SmartQuery/model/.cache/huggingface
HF_ENDPOINT=https://hf-mirror.com
